# Model weights — multi-GB GGUFs land here. Never track.
/models/

# Foundry: the public tree carries it as a git submodule at ./foundry; a private
# checkout may use a local symlink there instead, which must never be tracked.
# The Makefile finds Foundry at FOUNDRY=<path>, else ./foundry, else ../foundry.

# Plans, specs and benchmark write-ups live outside this repo. Symlinked in
# for local convenience; never tracked or published here.
/plans
__pycache__/
tests/bench_sampler_temp_delta
tests/test_sparse_sampler_identity
tests/test_topn_row_exact
tests/test_grammar_arm_window
tests/test_gdn_layout
