# Compiled test binaries. This used to be one line per test, so every NEW test
# was untracked until someone remembered to add it -- and a `git add tests/`
# then swept 2.8 MB of build artifacts into a commit. Pattern, not a roll-call.
tests/test_*
tests/bench_*
tests/gen_golden_*
!tests/*.c
!tests/*.h

# Parity-gate dumps and logs (L11 Mac CPU oracle): large, regenerable
tests/parity_out/

# Claude Code hooks are generated per machine by TeamIDE (they list local paths).
.claude/hooks/

# bench_ngram_accept --generate output (recorded token streams); make your own.
tests/data/ngram_accept_dumps/

